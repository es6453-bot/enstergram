# Server-only values. Add real production values in Vercel environment settings.
TURSO_DATABASE_URL=libsql://YOUR_DATABASE_HOST
TURSO_AUTH_TOKEN=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Numeric GitHub user ID of the owner (not a username).
OWNER_GITHUB_ID=
# Other numeric GitHub IDs, comma-separated. Blank means owner-only.
# Set * only if you want to allow every GitHub account to join.
ALLOWED_GITHUB_IDS=
# Optional Google OAuth (Auth.js). Both values enable the Google button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional passwordless email via Resend, using a verified sending domain.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
# Optional stable production origin.
# AUTH_URL=https://your-production-domain.example
